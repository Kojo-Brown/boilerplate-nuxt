# PostgreSQL connection URL (Nuxt reads runtimeConfig.databaseUrl via NUXT_DATABASE_URL)
NUXT_DATABASE_URL=postgresql://user:password@localhost:5432/boilerplate_nuxt

# Session encryption key — must be at least 32 characters
NUXT_SESSION_PASSWORD=your-super-secret-session-password-at-least-32-chars

# Redis, backing the Nitro `cache`, `sessions` and `idempotency` storage bases.
# Optional: leave it unset and both stay per-process, which is correct for dev
# and a single instance. Required for more than one instance — see
# docs/nitro-storage.md. Use rediss:// for TLS.
NUXT_REDIS_URL=redis://localhost:6379
# Key prefix, so the bases can share one Redis database (default: nuxt)
NUXT_REDIS_KEY_PREFIX=nuxt
# Hard ceiling in seconds on how long any cache key may live; 0 = no ceiling,
# and Nitro expires its own cache entries by their `maxAge` regardless
NUXT_REDIS_CACHE_TTL=0

# Idempotency keys on mutating routes (server/utils/idempotency.ts,
# docs/idempotency.md). Both optional and both clamped: retention to 60…604800
# seconds, the claim timeout to 5…600. The claim timeout is how long a key stays
# stuck after a process dies mid-handler, so it wants to be comfortably longer
# than the slowest wrapped handler and no longer.
NUXT_IDEMPOTENCY_RETENTION_SECONDS=86400
NUXT_IDEMPOTENCY_CLAIM_TIMEOUT_SECONDS=60

# Transactional outbox (server/utils/outbox.ts, docs/outbox.md). Mutating routes
# always write outbox rows inside their transaction; these settings only control
# the relay that delivers them.
# Where each event is POSTed, with the outbox row id as its Idempotency-Key.
# Unset means dev logs the events and a built server warns and does not poll —
# rows accumulate rather than being delivered.
NUXT_OUTBOX_WEBHOOK_URL=https://example.test/hooks/outbox
# Set false on instances that should enqueue but not deliver
NUXT_OUTBOX_RELAY_ENABLED=true
# All optional and all clamped: poll interval 50…60000, batch 1…500, base
# backoff 100…60000, max backoff 1000…3600000 (and never below the base),
# attempts 1…50, claim lease 1000…600000, publish timeout 100…60000. The claim
# lease must comfortably exceed the publish timeout.
NUXT_OUTBOX_RELAY_POLL_INTERVAL_MS=1000
NUXT_OUTBOX_RELAY_BATCH_SIZE=20
NUXT_OUTBOX_RELAY_BASE_BACKOFF_MS=1000
NUXT_OUTBOX_RELAY_MAX_BACKOFF_MS=300000
NUXT_OUTBOX_RELAY_MAX_ATTEMPTS=10
NUXT_OUTBOX_RELAY_CLAIM_LEASE_MS=30000
NUXT_OUTBOX_RELAY_PUBLISH_TIMEOUT_MS=5000

# WebSocket handshake tickets (server/utils/ws-ticket.ts, docs/websockets.md).
# All three are optional: the signing key is derived from NUXT_SESSION_PASSWORD
# with HKDF unless you set a separate secret here, the TTL defaults to 30s and is
# clamped to 300s, and the app's own host is always an allowed origin.
# NUXT_WS_TICKET_SECRET=a-second-secret-of-at-least-32-characters
NUXT_WS_TICKET_TTL_SECONDS=30
# Comma-separated extra origins, for a front end deployed separately from this API
NUXT_WS_ALLOWED_ORIGINS=

# GitHub OAuth app credentials
# Create an app at https://github.com/settings/developers
# Callback URL: http://localhost:3000/auth/github
NUXT_OAUTH_GITHUB_CLIENT_ID=your_github_client_id
NUXT_OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret

# AWS S3 (for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your_s3_bucket_name
