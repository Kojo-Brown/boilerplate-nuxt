# PostgreSQL connection URL (Nuxt reads runtimeConfig.databaseUrl via NUXT_DATABASE_URL)
NUXT_DATABASE_URL=postgresql://user:password@localhost:5432/boilerplate_nuxt

# Session encryption key. At least 32 characters, and not this placeholder: the
# server checks both at boot and refuses to start rather than failing on the
# first sign-in. Generate one with `openssl rand -base64 32`.
NUXT_SESSION_PASSWORD=your-super-secret-session-password-at-least-32-chars
# Cookie lifetime and seal TTL, in seconds. A week by default.
NUXT_SESSION_MAX_AGE=604800

# Session id rotation (server/utils/session-rotation.ts, docs/session-security.md).
# All three are optional and all are clamped.
# How old a session id may get before it is replaced on the next API request.
# Floored at 60s and capped at NUXT_SESSION_MAX_AGE; 0 turns rotation off, which
# leaves a captured cookie usable until it expires.
NUXT_SESSION_ROTATION_INTERVAL_SECONDS=900
# How long one sign-in may last, rotations included. h3 already bounds a session
# at NUXT_SESSION_MAX_AGE from its creation and rotation does not extend that;
# this makes the bound the app's own — settable shorter, revoked in the session
# registry, and answered as a named 401. Floored at the interval; 0 disables it.
NUXT_SESSION_ROTATION_ABSOLUTE_MAX_AGE_SECONDS=604800
# How long a replaced id keeps working, so requests already in flight when the id
# changed are not answered 401. Clamped to 1…300 and to a quarter of the interval.
NUXT_SESSION_ROTATION_GRACE_SECONDS=30

# CSRF (server/middleware/20.csrf.ts, docs/csrf.md). Both are optional.
# How long a CSRF token stays valid, in seconds. Clamped to 300…604800; the gate
# re-issues at half life on any document response, so an active tab never reaches
# the end of it. There is no separate CSRF secret: the signing key is derived
# from NUXT_SESSION_PASSWORD with HKDF.
NUXT_SECURITY_CSRF_TOKEN_TTL_SECONDS=43200
# Extra origins allowed to make state-changing requests, comma-separated. The
# request's own host is always allowed, so same-origin needs no configuration.
# Set this when a separate front end or a sibling subdomain genuinely posts here
# — a sibling is the same *site*, so SameSite=Lax would have sent the cookie and
# only this list decides whether the request is accepted.
NUXT_SECURITY_CSRF_ALLOWED_ORIGINS=https://admin.example.com

# The cookie's own attributes are set in nuxt.config.ts and checked at boot:
# httpOnly, Secure, SameSite=Lax, Path=/, and h3's session request header turned
# off so the cookie is the only carrier. They are overridable with NUXT_SESSION_*
# variables and the server refuses to start if an override weakens one.

# Redis, backing the Nitro `cache`, `sessions` and `idempotency` storage bases.
# Optional: leave it unset and both stay per-process, which is correct for dev
# and a single instance. Required for more than one instance — see
# docs/nitro-storage.md. Use rediss:// for TLS.
NUXT_REDIS_URL=redis://localhost:6379
# Key prefix, so the bases can share one Redis database (default: nuxt)
NUXT_REDIS_KEY_PREFIX=nuxt
# Hard ceiling in seconds on how long any cache key may live; 0 = no ceiling,
# and Nitro expires its own cache entries by their `maxAge` regardless
NUXT_REDIS_CACHE_TTL=0

# Idempotency keys on mutating routes (server/utils/idempotency.ts,
# docs/idempotency.md). Both optional and both clamped: retention to 60…604800
# seconds, the claim timeout to 5…600. The claim timeout is how long a key stays
# stuck after a process dies mid-handler, so it wants to be comfortably longer
# than the slowest wrapped handler and no longer.
NUXT_IDEMPOTENCY_RETENTION_SECONDS=86400
NUXT_IDEMPOTENCY_CLAIM_TIMEOUT_SECONDS=60

# Transactional outbox (server/utils/outbox.ts, docs/outbox.md). Mutating routes
# always write outbox rows inside their transaction; these settings only control
# the relay that delivers them.
# Where each event is POSTed, with the outbox row id as its Idempotency-Key.
# Unset means dev logs the events and a built server warns and does not poll —
# rows accumulate rather than being delivered.
NUXT_OUTBOX_WEBHOOK_URL=https://example.test/hooks/outbox
# Set false on instances that should enqueue but not deliver
NUXT_OUTBOX_RELAY_ENABLED=true
# All optional and all clamped: poll interval 50…60000, batch 1…500, base
# backoff 100…60000, max backoff 1000…3600000 (and never below the base),
# attempts 1…50, claim lease 1000…600000, publish timeout 100…60000. The claim
# lease must comfortably exceed the publish timeout.
NUXT_OUTBOX_RELAY_POLL_INTERVAL_MS=1000
NUXT_OUTBOX_RELAY_BATCH_SIZE=20
NUXT_OUTBOX_RELAY_BASE_BACKOFF_MS=1000
NUXT_OUTBOX_RELAY_MAX_BACKOFF_MS=300000
NUXT_OUTBOX_RELAY_MAX_ATTEMPTS=10
NUXT_OUTBOX_RELAY_CLAIM_LEASE_MS=30000
NUXT_OUTBOX_RELAY_PUBLISH_TIMEOUT_MS=5000

# WebSocket handshake tickets (server/utils/ws-ticket.ts, docs/websockets.md).
# All three are optional: the signing key is derived from NUXT_SESSION_PASSWORD
# with HKDF unless you set a separate secret here, the TTL defaults to 30s and is
# clamped to 300s, and the app's own host is always an allowed origin.
# NUXT_WS_TICKET_SECRET=a-second-secret-of-at-least-32-characters
NUXT_WS_TICKET_TTL_SECONDS=30
# Comma-separated extra origins, for a front end deployed separately from this API
NUXT_WS_ALLOWED_ORIGINS=

# Core Web Vitals (plugins/web-vitals.client.ts, docs/web-vitals.md). The browser
# beacons LCP/CLS/INP/FCP/TTFB to /api/vitals; the server forwards each batch to
# the collector below. Unset is supported: metrics then live only in the
# in-process rolling summary at GET /api/vitals/summary, which a deploy discards
# and a second instance does not share. A URL that is set but unparseable stops
# the server from booting rather than failing silently on every beacon.
NUXT_VITALS_SINK_URL=https://example.test/collect/vitals
# Per-delivery timeout in milliseconds, clamped to 100…30000. Batches are never
# retried — the next page load brings fresh numbers.
NUXT_VITALS_TIMEOUT_MS=3000
# Client-side switches. Public by nature: both are readable in the page payload,
# so neither is a place for anything secret.
NUXT_PUBLIC_WEB_VITALS_ENABLED=true
# Fraction of page loads that report, 0…1. Lower it when beacon volume starts to
# matter; a p75 over a sample is still a p75.
NUXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=1

# GitHub OAuth app credentials
# Create an app at https://github.com/settings/developers
# Callback URL: http://localhost:3000/auth/github
NUXT_OAUTH_GITHUB_CLIENT_ID=your_github_client_id
NUXT_OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret

# AWS S3 (for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your_s3_bucket_name

# Security response headers (server/plugins/security-headers.ts,
# docs/security-headers.md). Every value is optional; the defaults are a strict
# nonce-based CSP plus a year of HSTS on TLS requests.
# 'enforce' | 'report-only' | 'off'. Roll a policy change out with report-only:
# the browser reports what would have been blocked and blocks nothing.
NUXT_SECURITY_CSP_MODE=enforce
# Where violation reports are POSTed. A same-origin path or an absolute http(s)
# URL; anything else is dropped. Unset means the policy carries no report-uri.
NUXT_SECURITY_CSP_REPORT_URI=/api/csp-report
# Extra origins for connect-src / img-src, comma-separated — the API a
# deployment talks to, the CDN it loads images from. Same-origin needs no entry,
# and quoted keywords ('unsafe-inline' and friends) are rejected: those are
# decided in code, not in an environment variable.
NUXT_SECURITY_CSP_CONNECT_SRC=https://api.example.test,wss://live.example.test
NUXT_SECURITY_CSP_IMG_SRC=https://cdn.example.test
# Who may frame this app. Unset means 'none', matching X-Frame-Options: DENY.
NUXT_SECURITY_CSP_FRAME_ANCESTORS=
# HSTS, sent only on TLS requests. Clamped to 0…2 years. Zero is not "off": it
# is the documented way back off HSTS, since a browser that has already seen the
# header honours it until the max-age it was given expires.
NUXT_SECURITY_HSTS_MAX_AGE_SECONDS=31536000
NUXT_SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
# Off by default — submitting a domain to the preload list is close to
# irreversible. Dropped unless subdomains are included and max-age is ≥ 1 year.
NUXT_SECURITY_HSTS_PRELOAD=false
